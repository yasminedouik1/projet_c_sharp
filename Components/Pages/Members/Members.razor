@page "/members"
@* Garde-fou serveur : seuls les Admin peuvent charger cette route. *@
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@inject IMemberService MemberService
@inject NavigationManager NavManager

<PageTitle>Membres</PageTitle>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1">Gestion des membres</h1>
        <p class="text-muted mb-0 small">
            Entités <strong>Member</strong> (profils métier), distinctes des comptes Identity.
            Service : <code>IMemberService</code>.
        </p>
    </div>
</div>

@*
  Sur une page 100 % Admin, [Authorize] suffit pour la sécurité.
  AuthorizeView sert ici à regrouper les actions sensibles (boutons) : même modèle qu’une page partagée plusieurs rôles.
*@
<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body d-flex flex-wrap align-items-center gap-2">
                <button type="button" class="btn btn-primary" @onclick="GoToAdd">
                    <span class="bi bi-person-plus me-1" aria-hidden="true"></span>
                    Nouveau membre
                </button>
                <span class="text-muted small ms-md-auto">Les utilisateurs finaux ont le rôle Identity « User ».</span>
            </div>
        </div>

        @if (_isLoading)
        {
            <p class="text-muted"><em>Chargement...</em></p>
        }
        else if (_members.Count == 0)
        {
            <div class="alert alert-light border">Aucun membre enregistré.</div>
        }
        else
        {
            <div class="table-responsive card border-0 shadow-sm">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Nom complet</th>
                            <th scope="col">Email</th>
                            <th scope="col">Rôle métier</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in _members)
                        {
                            <tr>
                                <td class="align-middle">@member.FullName</td>
                                <td class="align-middle">@member.Email</td>
                                <td class="align-middle">@(member.Role ?? "—")</td>
                                <td class="align-middle text-end text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-warning me-1"
                                            @onclick="() => GoToEdit(member.Id)">
                                        Modifier
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            @onclick="() => Delete(member.Id)">
                                        Supprimer
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            Cette section est réservée aux administrateurs.
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<Member> _members = new();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _members = await MemberService.GetAllAsync();
        _isLoading = false;
    }

    private void GoToAdd() => NavManager.NavigateTo("/members/add");

    private void GoToEdit(int id) => NavManager.NavigateTo($"/members/edit/{id}");

    private async Task Delete(int id)
    {
        await MemberService.DeleteAsync(id);
        _members = await MemberService.GetAllAsync();
    }
}
