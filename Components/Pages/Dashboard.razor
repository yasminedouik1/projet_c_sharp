@page "/dashboard"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@using ProjectManager.Models
@using ProjectManager.Services

@inject IProjectService ProjectService
@inject IUserProjectService UserProjectService
@inject IAnalyticsService AnalyticsService

<PageTitle>Tableau de bord</PageTitle>

<h1>Tableau de bord</h1>

<div class="alert alert-info">
    Bienvenue sur l'interface de pilotage des projets<br>
    Nous sommes le : <strong>@DateTime.Now.ToString("dd MMMM yyyy")</strong>
</div>

<button class="btn btn-primary mb-3" @onclick="RefreshDashboard">
    <span class="oi oi-reload"></span> Actualiser le tableau de bord
</button>

<div class="mt-3 card card-body">
    Logs : @LastLog
</div>

@if (_isLoading)
{
    <p class="mt-3"><em>Chargement des indicateurs...</em></p>
}
else
{
    <!-- KPIs -->
    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h6 class="text-muted">Projets actifs</h6>
                <h2>@_activeProjects</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h6 class="text-muted">Utilisateurs (rôle User)</h6>
                <h2>@_totalUsers</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h6 class="text-muted">Tâches en retard</h6>
                <h2 class="text-danger">@_totalOverdue</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h6 class="text-muted">Tâches terminées</h6>
                <h2 class="text-success">@_totalCompleted</h2>
            </div>
        </div>
    </div>

    <!-- ====================== SANTÉ DES PROJETS ====================== -->
    <h4 class="mt-5">Santé des projets</h4>

    <div class="row mb-3">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" 
                       @bind="_projectSearchText" 
                       @bind:event="oninput"
                       class="form-control" 
                       placeholder="Rechercher par nom de projet..." />
            </div>
        </div>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Projet</th>
                <th>Santé</th>
                <th>Score</th>
                <th>Tâches terminées</th>
                <th>En retard</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in FilteredProjectScores)
            {
                <tr>
                    <td>@item.ProjectName</td>
                    <td>
                        <span class="badge @GetHealthColor(item.Score)">
                            @GetHealthLabel(item.Score)
                        </span>
                    </td>
                    <td>
                        <div class="progress" style="height: 18px;">
                            <div class="progress-bar @GetHealthColor(item.Score)" 
                                 style="width: @item.Score%">@item.Score%</div>
                        </div>
                    </td>
                    <td>@item.Completed</td>
                    <td class="@(item.Overdue > 0 ? "text-danger" : "")">@item.Overdue</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- ====================== PERFORMANCE DES UTILISATEURS ====================== -->
    <h4 class="mt-5">Performance des utilisateurs</h4>

    <div class="mb-3">
        <select class="form-select w-auto" @bind="_selectedMemberStatusFilter">
            <option value="All">Tous les utilisateurs</option>
            <option value="Performant">Performant</option>
            <option value="Surveiller">À surveiller</option>
            <option value="Difficulte">En difficulté</option>
        </select>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Utilisateur</th>
                <th>Taux de complétion</th>
                <th>Charge de travail</th>
                <th>Retard</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in FilteredMemberStats)
            {
                <tr>
                    <td>@m.FullName</td>
                    <td>
                        <div class="progress" style="height: 18px;">
                            <div class="progress-bar bg-success" style="width:@m.CompletionRate%">
                                @m.CompletionRate%
                            </div>
                        </div>
                    </td>
                    <td>@m.Workload tâche(s)</td>
                    <td class="@(m.OverdueCount > 0 ? "text-danger fw-bold" : "")">@m.OverdueCount</td>
                    <td>
                        <span class="badge @GetMemberBadge(m.CompletionRate, m.OverdueCount)">
                            @GetMemberLabel(m.CompletionRate, m.OverdueCount)
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool _isLoading = true;

    private int _activeProjects;
    private int _totalUsers;
    private int _totalOverdue;
    private int _totalCompleted;

    private List<ProjectScoreViewModel> _projectScores = new();
    private List<MemberStatViewModel> _memberStats = new();

    // Filtres
    private string _projectSearchText = "";
    private string _selectedMemberStatusFilter = "All";

    private bool IsSystemOK = true;
    private int RequestCount = 0;
    private string LastLog = "Rien à signaler";

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        _isLoading = true;

        var projects = await ProjectService.GetAllAsync();
        var directoryUsers = (await UserProjectService.GetDirectoryUsersAsync()).ToList();

        _activeProjects = projects.Count(p => p.Status == ProjectStatus.Active);
        _totalUsers = directoryUsers.Count;
        _totalCompleted = projects.Sum(p => p.Tasks.Count(t => t.Status == Models.TaskStatus.Done));
        _totalOverdue = projects.Sum(p => p.Tasks.Count(t => t.DueDate < DateTime.Now && t.Status != Models.TaskStatus.Done));

        // Chargement des scores projets
        _projectScores.Clear();
        foreach (var project in projects)
        {
            var score = await AnalyticsService.GetHealthScoreAsync(project.Id);
            var completed = await AnalyticsService.GetCompletedTasksCountAsync(project.Id);
            var overdue = await AnalyticsService.GetOverdueTasksCountAsync(project.Id);

            _projectScores.Add(new ProjectScoreViewModel
            {
                ProjectName = project.Name,
                Score = score,
                Completed = completed,
                Overdue = overdue
            });
        }

        await LoadMemberStatsAsync(directoryUsers);

        _isLoading = false;
    }

    private async Task LoadMemberStatsAsync(List<ApplicationUser> users)
    {
        _memberStats.Clear();
        foreach (var user in users)
        {
            var rate = await AnalyticsService.GetUserCompletionRateAsync(user.Id);
            var workload = await AnalyticsService.GetUserWorkloadAsync(user.Id);
            var overdue = await AnalyticsService.GetUserOverdueCountAsync(user.Id);

            _memberStats.Add(new MemberStatViewModel
            {
                FullName = user.DisplayName ?? user.Email ?? user.UserName ?? user.Id,
                CompletionRate = rate,
                Workload = workload,
                OverdueCount = overdue
            });
        }
    }

    // ================== FILTRES ==================

    private List<ProjectScoreViewModel> FilteredProjectScores =>
        string.IsNullOrWhiteSpace(_projectSearchText)
            ? _projectScores
            : _projectScores.Where(p => p.ProjectName.Contains(_projectSearchText, StringComparison.OrdinalIgnoreCase))
                            .ToList();

    private List<MemberStatViewModel> FilteredMemberStats
    {
        get
        {
            var query = _memberStats.AsEnumerable();

            if (_selectedMemberStatusFilter != "All")
            {
                query = _selectedMemberStatusFilter switch
                {
                    "Performant" => query.Where(m => GetMemberLabel(m.CompletionRate, m.OverdueCount) == "Performant"),
                    "Surveiller" => query.Where(m => GetMemberLabel(m.CompletionRate, m.OverdueCount) == "À surveiller"),
                    "Difficulte" => query.Where(m => GetMemberLabel(m.CompletionRate, m.OverdueCount) == "En difficulté"),
                    _ => query
                };
            }

            return query.ToList();
        }
    }

    private async Task RefreshDashboard()
    {
        RequestCount++;
        var rnd = new Random();
        IsSystemOK = rnd.Next(0, 10) > 2;

        LastLog = IsSystemOK 
            ? $"Check {RequestCount} : Tout va bien" 
            : $"Check {RequestCount} : Anomalie détectée";

        await LoadDashboardData();
    }

    // Méthodes existantes (GetHealthColor, GetHealthLabel, etc.)
    private string GetHealthColor(double score) => score switch
    {
        > 75 => "bg-success",
        > 40 => "bg-warning",
        _    => "bg-danger"
    };

    private string GetHealthLabel(double score) => score switch
    {
        > 75 => "Sain",
        > 40 => "Risqué",
        _    => "Critique"
    };

    private string GetMemberBadge(double rate, int overdue) =>
        overdue > 2 ? "bg-danger" : rate >= 70 ? "bg-success" : "bg-warning";

    private string GetMemberLabel(double rate, int overdue) =>
        overdue > 2 ? "En difficulté" : rate >= 70 ? "Performant" : "À surveiller";

    // ViewModels
    protected class ProjectScoreViewModel
    {
        public string ProjectName { get; set; } = "";
        public double Score { get; set; }
        public int Completed { get; set; }
        public int Overdue { get; set; }
    }

    protected class MemberStatViewModel
    {
        public string FullName { get; set; } = "";
        public double CompletionRate { get; set; }
        public int Workload { get; set; }
        public int OverdueCount { get; set; }
    }
}