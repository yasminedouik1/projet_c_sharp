@page "/my-projects"
@attribute [Authorize(Roles = "Member")]
@rendermode InteractiveServer
@using ProjectManager.Models
@using ProjectManager.Services
@using System.Security.Claims
@inject IMyProjectsService MyProjectsService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Mes Projets</PageTitle>

<div class="container mt-4">
    <h1>Mes Projets</h1>

    @if (_selectedMember == null)
    {
        <p><em>Chargement...</em></p>
    }
    else
    {
        <h4>Projets de : <strong>@_selectedMember.FullName</strong></h4>

        @if (_projects.Count == 0)
        {
            <p class="text-muted">Aucun projet assigné pour le moment.</p>
        }
        else if (_selectedProject == null)
        {
            <div class="row">
                @foreach (var project in _projects)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="project-list-card" @onclick="() => SelectProject(project)">
                            <h5>@project.Name</h5>
                            <p>@project.Description</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-primary">@project.Status</span>
                                <small class="text-muted">@project.Tasks.Count tâches</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="mb-3">
                <button class="btn btn-outline-secondary" @onclick="BackToList">
                    ← Retour à la liste des projets
                </button>
            </div>

            <ProjectCard Project="_selectedProject"
                         MemberId="_selectedMember.Id"
                         ReadOnly="true" />
        }
    }
</div>

<style>
    .project-list-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.5rem;
        cursor: pointer;
        transition: all 0.2s;
        height: 100%;
    }

    .project-list-card:hover {
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        transform: translateY(-4px);
        border-color: #6366f1;
    }
</style>

@code {
    private List<Project> _projects = new();
    private Member? _selectedMember;
    private Project? _selectedProject;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var email = authState.User.FindFirst(ClaimTypes.Email)?.Value
            ?? authState.User.Identity?.Name;

        if (string.IsNullOrEmpty(email)) return;

        _selectedMember = (await MyProjectsService.GetAllMembersAsync())
            .FirstOrDefault(m => m.Email.Equals(email, StringComparison.OrdinalIgnoreCase));

        if (_selectedMember != null)
            _projects = await MyProjectsService.GetProjectsByMemberAsync(_selectedMember.Id);
    }

    private void SelectProject(Project project)
    {
        _selectedProject = project;
    }

    private void BackToList()
    {
        _selectedProject = null;
    }
}
