@page "/my-projects"
@attribute [Authorize(Roles = "User")]
@rendermode InteractiveServer

@using System.Security.Claims

@inject IMyProjectsService MyProjectsService
@inject AuthenticationStateProvider AuthStateProvider

<h3 class="mb-3">Mes projets</h3>

@if (projects == null)
{
    <p><em>Chargement des projets…</em></p>
}
else if (projects.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        Pas de projets assignés pour le moment. Un administrateur doit vous ajouter à un projet.
    </div>
}
else
{
    <div class="row">
        @foreach (var project in projects)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <ProjectCard Project="project"
                             UserId="@currentUserId"
                             OnTaskStatusChanged="RefreshProjects" />
            </div>
        }
    </div>
}

@code {
    private List<Project>? projects;
    private string currentUserId = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadMyProjects();
    }

    private async Task LoadMyProjects()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";

        if (string.IsNullOrEmpty(currentUserId))
        {
            projects = new();
            return;
        }

        projects = await MyProjectsService.GetProjectsByUserIdAsync(currentUserId);
    }

    private async Task RefreshProjects()
    {
        if (!string.IsNullOrEmpty(currentUserId))
        {
            projects = await MyProjectsService.GetProjectsByUserIdAsync(currentUserId);
            StateHasChanged();
        }
    }
}
