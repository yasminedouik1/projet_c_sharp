@page "/my-projects"
@attribute [Authorize(Roles = "User")]
@rendermode InteractiveServer

@using System.Security.Claims

@inject IMyProjectsService MyProjectsService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<h3>Mes Projets</h3>

@if (projects == null)
{
    <p><em>Chargement des projets...</em></p>
}
else if (projects.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        Pas de projets assignés pour le moment.
    </div>
}
else
{
    <div class="row">
        @foreach (var project in projects)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <ProjectCard Project="project" 
                             MemberId="currentMemberId" 
                             OnTaskStatusChanged="RefreshProjects" />
            </div>
        }
    </div>
}

@code {
    private List<Project> projects = new();
    private int currentMemberId = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadMyProjects();
    }

    private async Task LoadMyProjects()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var email = authState.User.FindFirst(ClaimTypes.Email)?.Value;

        if (string.IsNullOrEmpty(email))
            return;

        var member = await MyProjectsService.GetMemberByEmailAsync(email);

        if (member != null)
        {
            currentMemberId = member.Id;
            projects = await MyProjectsService.GetProjectsByMemberAsync(currentMemberId);
        }
    }

    private async Task RefreshProjects()
    {
        if (currentMemberId > 0)
        {
            projects = await MyProjectsService.GetProjectsByMemberAsync(currentMemberId);
            StateHasChanged();
        }
    }
}