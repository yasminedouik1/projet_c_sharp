@using ProjectManager.Models
@using ProjectManager.Services
@inject IMyProjectsService MyProjectsService
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="kanban-board" @ref="_boardRef">
    @foreach (var status in _columns)
    {
        <div class="kanban-column @GetColumnClass(status)"
             @ondragover:preventDefault="@(!ReadOnly)"
             @ondrop="() => OnDrop(status)">

            <div class="kanban-col-header">
                <span class="col-icon">@GetColumnIcon(status)</span>
                <span class="col-title">@GetColumnLabel(status)</span>
                <span class="col-count">@_tasks.Count(t => t.Status == status)</span>
            </div>

            <div class="kanban-col-body">
                @foreach (var task in _tasks.Where(t => t.Status == status))
                {
                    <div class="kanban-card @(IsOverdue(task) ? "overdue" : "")"
                         draggable="@(!ReadOnly)"
                         @ondragstart="() => OnDragStart(task)">

                        <div class="kc-title">@task.Title</div>

                        @if (!string.IsNullOrEmpty(task.Description))
                        {
                            <div class="kc-desc">@task.Description</div>
                        }

                        <div class="kc-footer">
                            <span class="kc-date @(IsOverdue(task) ? "kc-date-overdue" : "")">
                                📅 @task.DueDate.ToString("dd/MM/yy")
                                @if (IsOverdue(task)) { <span> ⚠️ En retard</span> }
                            </span>
                        </div>
                    </div>
                }

                @if (!_tasks.Any(t => t.Status == status))
                {
                    <div class="kanban-empty">Déposez ici</div>
                }
            </div>
        </div>
    }
</div>

<style>
    .kanban-board {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        padding: 1.5rem 2rem;
        background: #f8fafc;
        min-height: 300px;
    }

    .kanban-column {
        background: white;
        border-radius: 12px;
        border: 2px dashed transparent;
        transition: border-color 0.2s, background 0.2s;
        min-height: 200px;
    }

    .kanban-column.col-todo    { border-top: 4px solid #94a3b8; }
    .kanban-column.col-inprog  { border-top: 4px solid #6366f1; }
    .kanban-column.col-done    { border-top: 4px solid #22c55e; }

    .kanban-column:hover {
        border-color: #6366f1;
        background: #fafbff;
    }

    .kanban-col-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 1rem 1rem 0.75rem;
        font-weight: 700;
        font-size: 0.9rem;
        color: #334155;
    }

    .col-count {
        margin-left: auto;
        background: #e2e8f0;
        color: #475569;
        border-radius: 20px;
        padding: 0.1rem 0.6rem;
        font-size: 0.78rem;
    }

    .kanban-col-body {
        padding: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .kanban-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 0.85rem;
        cursor: grab;
        transition: box-shadow 0.2s, transform 0.15s, opacity 0.15s;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        user-select: none;
        -webkit-user-select: none;
        -webkit-user-drag: element;
    }

    .kanban-card * {
        -webkit-user-drag: none;
        user-select: none;
        pointer-events: none;
    }

    .kanban-card:hover {
        box-shadow: 0 6px 20px rgba(99,102,241,0.15);
        transform: translateY(-2px);
    }

    .kanban-card:active { cursor: grabbing; }

    .kanban-card.is-dragging {
        opacity: 0.45;
        transform: scale(0.98);
        box-shadow: 0 8px 24px rgba(99, 102, 241, 0.25);
    }

    .kanban-card.overdue {
        border-left: 4px solid #ef4444;
        background: #fff8f8;
    }

    .kc-title {
        font-weight: 600;
        font-size: 0.9rem;
        color: #1e293b;
        margin-bottom: 0.3rem;
    }

    .kc-desc {
        font-size: 0.8rem;
        color: #64748b;
        margin-bottom: 0.5rem;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .kc-footer { display: flex; justify-content: flex-end; }

    .kc-date {
        font-size: 0.75rem;
        color: #94a3b8;
    }

    .kc-date-overdue { color: #ef4444; font-weight: 600; }

    .kanban-empty {
        text-align: center;
        padding: 2rem 1rem;
        color: #cbd5e1;
        font-size: 0.85rem;
        border: 2px dashed #e2e8f0;
        border-radius: 8px;
        margin: 0.5rem;
    }
</style>

@code {
    [Parameter] public int ProjectId { get; set; }
    [Parameter] public int MemberId { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback OnTaskStatusChanged { get; set; }

    private ElementReference _boardRef;
    private IJSObjectReference? _dragModule;
    private List<ProjectTask> _tasks = new();
    private ProjectTask? _draggedTask;

    private readonly Models.TaskStatus[] _columns =
    [
        Models.TaskStatus.Todo,
        Models.TaskStatus.InProgress,
        Models.TaskStatus.Done
    ];

    protected override async Task OnParametersSetAsync()
    {
        await LoadTasks();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dragModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/kanbanDrag.js");
            await _dragModule.InvokeVoidAsync("attach", _boardRef);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_dragModule is not null)
            await _dragModule.DisposeAsync();
    }

    private async Task LoadTasks()
    {
        _tasks = await MyProjectsService.GetTasksByMemberAndProjectAsync(MemberId, ProjectId);
    }

    private void OnDragStart(ProjectTask task)
    {
        if (ReadOnly) return;
        _draggedTask = task;
    }

    private async Task OnDrop(Models.TaskStatus targetStatus)
    {
        if (ReadOnly) return;
        if (_draggedTask is null || _draggedTask.Status == targetStatus) return;

        await MyProjectsService.UpdateTaskStatusAsync(_draggedTask.Id, targetStatus);
        _draggedTask.Status = targetStatus;
        _draggedTask = null;

        await OnTaskStatusChanged.InvokeAsync();
        StateHasChanged();
    }

    private bool IsOverdue(ProjectTask task) =>
        task.Status != Models.TaskStatus.Done && task.DueDate < DateTime.Now;

    private string GetColumnClass(Models.TaskStatus s) => s switch
    {
        Models.TaskStatus.Todo       => "col-todo",
        Models.TaskStatus.InProgress => "col-inprog",
        Models.TaskStatus.Done       => "col-done",
        _ => ""
    };

    private string GetColumnIcon(Models.TaskStatus s) => s switch
    {
        Models.TaskStatus.Todo       => "📋",
        Models.TaskStatus.InProgress => "🔄",
        Models.TaskStatus.Done       => "✅",
        _ => ""
    };

    private string GetColumnLabel(Models.TaskStatus s) => s switch
    {
        Models.TaskStatus.Todo       => "À faire",
        Models.TaskStatus.InProgress => "En cours",
        Models.TaskStatus.Done       => "Terminé",
        _ => s.ToString()
    };
}
