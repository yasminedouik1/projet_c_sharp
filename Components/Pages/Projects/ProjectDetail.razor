@page "/projects/{Id:int}"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject IJSRuntime JS

@using ProjectManager.Models
@using ProjectManager.Services

@inject IProjectService ProjectService
@inject ITaskService TaskService
@inject IUserProjectService UserProjectService
@inject NavigationManager NavManager

<PageTitle>Détail Projet</PageTitle>

@if (_isLoading)
{
    <p><em>Chargement...</em></p>
}
else if (_project == null)
{
    <p class="text-danger">Projet introuvable.</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@_project.Name</h1>
        <button class="btn btn-secondary" @onclick="GoBack">← Retour à la liste</button>
    </div>

    <p class="text-muted">@_project.Description</p>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-center p-3">
                <h5>Début</h5>
                <p>@_project.StartDate.ToString("dd/MM/yyyy")</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center p-3">
                <h5>Date limite</h5>
                <p>@_project.DueDate.ToString("dd/MM/yyyy")</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center p-3">
                <h5>Statut</h5>
                <p>@_project.Status</p>
            </div>
        </div>
    </div>

    <h4>Membres du projet (@_project.ProjectUsers.Count)</h4>

    <div class="mb-3">
        <h6 class="text-muted">Ajouter un utilisateur</h6>
        <div class="d-flex gap-2 flex-wrap">
            <select class="form-select" @bind="_selectedUserId" style="max-width: 350px;">
                <option value="">-- Choisir un utilisateur --</option>
                @foreach (var u in _directoryUsers.Where(u => !_project.ProjectUsers.Any(pu => pu.UserId == u.Id)))
                {
                    <option value="@u.Id">@(u.DisplayName ?? u.Email)</option>
                }
            </select>
            <button class="btn btn-success"
                    @onclick="AddUser"
                    disabled="@string.IsNullOrEmpty(_selectedUserId)">
                + Ajouter
            </button>
        </div>
    </div>

    @if (_project.ProjectUsers.Count > 0)
    {
        <ul class="list-group mb-4">
            @foreach (var pu in _project.ProjectUsers.OrderBy(x => x.User?.DisplayName ?? x.User?.Email))
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>@(pu.User?.DisplayName ?? pu.User?.Email ?? pu.UserId)</span>
                    <button class="btn btn-sm btn-danger"
                            @onclick="() => RemoveUser(pu.UserId)">
                        Retirer
                    </button>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted">Aucun membre assigné à ce projet.</p>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Tâches (@_project.Tasks.Count)</h4>
        <button class="btn btn-primary" @onclick="GoToAddTask">
            + Nouvelle Tâche
        </button>
    </div>

    @if (_project.Tasks.Count == 0)
    {
        <p>Aucune tâche pour ce projet.</p>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-light">
                <tr>
                    <th>Titre</th>
                    <th>Description</th>
                    <th>Date limite</th>
                    <th>Statut</th>
                    <th>Assigné à</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in _project.Tasks)
                {
                    <tr class="@(IsOverdue(task) ? "table-danger" : "")">
                        <td><strong>@task.Title</strong></td>
                        <td>@(task.Description?.Length > 60 ? task.Description.Substring(0, 60) + "..." : task.Description)</td>
                        <td>@task.DueDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="badge @GetStatusBadge(task.Status)">
                                @GetStatusLabel(task.Status)
                            </span>
                        </td>
                        <td>@(task.AssignedUser is null ? "Non assigné" : (task.AssignedUser.DisplayName ?? task.AssignedUser.Email ?? "—"))</td>
                        <td>
                            <button class="btn btn-sm btn-warning me-2"
                                    @onclick="() => GoToEditTask(task.Id)">
                                Modifier
                            </button>
                            <button class="btn btn-sm btn-danger"
                                    @onclick="() => DeleteTask(task.Id)">
                                Supprimer
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private Project? _project;
    private bool _isLoading = true;
    private List<ApplicationUser> _directoryUsers = new();
    private string _selectedUserId = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _project = await ProjectService.GetByIdAsync(Id);
        _directoryUsers = (await UserProjectService.GetDirectoryUsersAsync()).ToList();
        _isLoading = false;
    }

    private async Task AddUser()
    {
        if (string.IsNullOrEmpty(_selectedUserId)) return;

        await UserProjectService.AddUserToProjectAsync(Id, _selectedUserId);
        _selectedUserId = "";
        await LoadData();
    }

    private async Task RemoveUser(string userId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Retirer cet utilisateur du projet ?");
        if (!confirmed) return;

        await UserProjectService.RemoveUserFromProjectAsync(Id, userId);
        await LoadData();
    }

    private static bool IsOverdue(ProjectTask task) =>
        task.DueDate < DateTime.Now && task.Status != Models.TaskStatus.Done;

    private static string GetStatusBadge(Models.TaskStatus status) => status switch
    {
        Models.TaskStatus.Done => "bg-success",
        Models.TaskStatus.InProgress => "bg-warning",
        Models.TaskStatus.Todo => "bg-secondary",
        _ => "bg-secondary"
    };

    private static string GetStatusLabel(Models.TaskStatus status) => status switch
    {
        Models.TaskStatus.Todo => "À faire",
        Models.TaskStatus.InProgress => "En cours",
        Models.TaskStatus.Done => "Terminé",
        _ => status.ToString()
    };

    private void GoToAddTask() => NavManager.NavigateTo($"/tasks/{Id}/add");
    private void GoToEditTask(int taskId) => NavManager.NavigateTo($"/tasks/edit/{taskId}");
    private void GoBack() => NavManager.NavigateTo("/projects");

    private async Task DeleteTask(int taskId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Voulez-vous vraiment supprimer cette tâche ?");
        if (!confirmed) return;

        await TaskService.DeleteAsync(taskId);
        await LoadData();
    }
}
