@page "/tasks/{ProjectId:int}/add"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@using ProjectManager.Models
@using ProjectManager.Services
@using TaskStatusEnum = ProjectManager.Models.TaskStatus

@inject ITaskService TaskService
@inject IMemberService MemberService
@inject NavigationManager NavManager

<PageTitle>Nouvelle Tâche</PageTitle>

<h1>Nouvelle Tâche</h1>

<EditForm Model="_task" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="card p-4" style="max-width: 700px;">
        
        <div class="mb-3">
            <label class="form-label">Titre <span class="text-danger">*</span></label>
            <InputText class="form-control" @bind-Value="_task.Title" />
            <ValidationMessage For="() => _task.Title" />
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <InputTextArea class="form-control" @bind-Value="_task.Description" rows="4" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Date limite <span class="text-danger">*</span></label>
                <InputDate class="form-control" @bind-Value="_task.DueDate" />
                <ValidationMessage For="() => _task.DueDate" />
            </div>

            <!-- Statut supprimé du formulaire (fixé à Todo) -->
        </div>

        <div class="mb-3">
            <label class="form-label">Assigné à</label>
            <InputSelect class="form-select" @bind-Value="_task.AssignedMemberId">
                <option value="">-- Non assigné --</option>
                @foreach (var m in _members)
                {
                    <option value="@m.Id">@m.FullName</option>
                }
            </InputSelect>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Créer la tâche</button>
            <button type="button" class="btn btn-secondary" @onclick="Cancel">Annuler</button>
        </div>
    </div>
</EditForm>

@code {
    [Parameter] public int ProjectId { get; set; }

    private ProjectTask _task = new() 
    { 
        DueDate = DateTime.Now.AddDays(7),
        Status = TaskStatusEnum.Todo,   // Statut fixé par défaut
        ProjectId = 0
    };

    private List<Member> _members = new();

    protected override async Task OnInitializedAsync()
    {
        _task.ProjectId = ProjectId;
        _members = await MemberService.GetMembersByProjectAsync(ProjectId);
    }

    private async Task Save()
    {
        // On force à nouveau Todo au cas où
        _task.Status = TaskStatusEnum.Todo;

        await TaskService.AddAsync(_task);
        NavManager.NavigateTo($"/projects/{ProjectId}");
    }

    private void Cancel()
    {
        NavManager.NavigateTo($"/projects/{ProjectId}");
    }
}