@page "/test-data"
@attribute [Authorize(Roles = "Admin")]
@using ProjectManager.Models
@using ProjectManager.Services
@using ProjectManager.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db

<PageTitle>Test Données</PageTitle>

<div class="container mt-4">
    <h1>Test base — ProjectUsers</h1>

    <button class="btn btn-primary mb-3" type="button" @onclick="CheckData">
        Vérifier les liaisons Projet ↔ Utilisateur
    </button>

    <hr />

    <h4>Résultat</h4>
    <pre class="bg-light p-3 rounded small">@result</pre>
</div>

@code {
    private string result = "Cliquez sur le bouton pour vérifier…";

    private async Task CheckData()
    {
        try
        {
            var links = await Db.ProjectUsers
                .Include(pu => pu.Project)
                .Include(pu => pu.User)
                .AsNoTracking()
                .ToListAsync();

            result = $"Liaisons ProjectUsers : {links.Count}\n\n";

            if (links.Count == 0)
            {
                result += "Aucune liaison. Ajoutez des utilisateurs à des projets depuis la page Utilisateurs ou le détail projet.";
            }
            else
            {
                foreach (var pu in links)
                {
                    var name = pu.User?.DisplayName ?? pu.User?.Email ?? pu.UserId;
                    result += $"• {pu.Project?.Name} ← {name}\n";
                }
            }
        }
        catch (Exception ex)
        {
            result = $"Erreur : {ex.Message}";
        }

        StateHasChanged();
    }
}
